# ==============================================================================
# Cyber Crew CTF - Production & Local Development Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit real production credentials or private keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application & Network Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://ctf.cybercrew.online
CORS_ORIGIN=https://ctf.cybercrew.online
PRODUCTION_DOMAIN=https://ctf.cybercrew.online
API_PREFIX=api/v1

# ------------------------------------------------------------------------------
# Supabase & Database Configuration (Backend Only Secrets)
# ------------------------------------------------------------------------------
# Public Supabase URL (accessible from frontend and backend)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (safe for frontend usage)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# Supabase Service Role Key (BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# PostgreSQL Direct Connection URL (for backend Prisma / direct client)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# JWT Secret for Supabase Auth token verification (BACKEND ONLY)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ------------------------------------------------------------------------------
# Storage Configuration
# ------------------------------------------------------------------------------
SUPABASE_STORAGE_BUCKET_CHALLENGES=challenge-files
SUPABASE_STORAGE_BUCKET_AVATARS=avatars
MAX_CHALLENGE_FILE_SIZE_MB=100
MAX_CHALLENGE_FILES=20

# ------------------------------------------------------------------------------
# Flag Security & Anti-Cheat
# ------------------------------------------------------------------------------
# Secret key used for HMAC flag verification and blind hashing (BACKEND ONLY)
FLAG_SECRET_SALT=your-secure-random-salt-for-flag-hashing-min-32-chars

# ------------------------------------------------------------------------------
# Rate Limiting & Redis Configuration
# ------------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=30
SUBMISSION_THROTTLE_TTL=60
SUBMISSION_THROTTLE_LIMIT=10

# Redis distributed cache & rate limiting
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=your_secure_redis_password_here

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vite Build Args - Treated as Public)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key
VITE_API_URL=/api/v1
VITE_APP_NAME="Cyber Crew CTF"
VITE_APP_DOMAIN=https://ctf.cybercrew.online
